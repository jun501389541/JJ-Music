{
  "name": "jj-music",
  "version": "0.1.5",
  "description": "JJ Music — 支持本地与联网的音乐播放器，兼容 LX Music 音源脚本，UI 参考 Salt Player",
  "main": "./out/main/index.js",
  "author": "JJ Music",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node tools/run-tests.mjs",
    "test:online": "node tools/run-tests.mjs --online",
    "test:e2e": "node tools/run-e2e.mjs",
    "diagnose": "node tools/diagnose-online.mjs",
    "verify": "npm run typecheck && npm run build && npm run test",
    "verify:all": "npm run verify && npm run test:e2e",
    "icon": "node tools/make-icon.mjs",
    "pack": "node tools/package.mjs --dir",
    "dist": "node tools/package.mjs",
    "build:win": "npm run dist"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "music-metadata": "^11.9.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "pinia": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.1"
  }
}
